# AI Dentist — staging/production-capable worker image (apps/worker).
# Long-running Node process. Do not convert to serverless.
# SMTP remains fail-closed unless explicit validated configuration enables it.

FROM node:22-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/application/package.json packages/application/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/test-utils/package.json packages/test-utils/
RUN pnpm install --frozen-lockfile
COPY . .
ENV NODE_ENV=production \
    AUTH_PROVIDER=unset \
    DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dentalcare \
    APP_BASE_URL=http://localhost:3000 \
    NOTIFICATION_PROCESSING_ENABLED=false \
    NOTIFICATION_PROVIDER=unset \
    NOTIFICATION_ALLOW_REAL_DELIVERY=false
RUN pnpm build:packages && pnpm --filter @dentalcare/worker build

FROM base AS runner
ENV NODE_ENV=production \
    AUTH_PROVIDER=unset \
    NOTIFICATION_PROCESSING_ENABLED=false \
    NOTIFICATION_PROVIDER=unset \
    NOTIFICATION_ALLOW_REAL_DELIVERY=false
WORKDIR /app
COPY --from=build /app /app
USER node
# Existing worker handles SIGINT/SIGTERM for graceful shutdown.
CMD ["pnpm", "--filter", "@dentalcare/worker", "start"]
