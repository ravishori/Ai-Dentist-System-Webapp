// DentalCare AI — Prisma baseline (M0)
//
// PostgreSQL is the transactional system of record (TDA-IMP-M0-002, TDA-TDD-001).
// Schema evolution is owned by Prisma migrations.
//
// M0 must not invent Patient, Appointment, Notification, or Foundation business tables.
// Domain schema is implemented from approved DDD documents in later milestones:
//   M1  Foundation & Identity  (TDA-DDD-001-D01)
//   M2  Patient                (TDA-DDD-PAT-001)
//   M3  Appointment            (TDA-DDD-APT-001)
//   M4  Notification outbox    (TDA-DDD-NOTIF-001)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
