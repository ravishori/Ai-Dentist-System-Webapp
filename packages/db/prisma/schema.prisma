// DentalCare AI — Prisma schema
//
// PostgreSQL is the transactional system of record (TDA-IMP-M0-002, TDA-ADR-001).
// Schema evolution is owned by Prisma migrations.
//
// M1: authentication identity-mapping and session persistence.
// M2: organization/tenant, membership, RBAC catalog, security event log.
// M3: organization-scoped patient identity.
// M4: organization-scoped appointments and minimum practitioner profiles.
// M5: appointment-notification consent and outbox delivery metadata.
// M7: practitioner status, branch assignment, weekly hours, and dated unavailability.
// C3: passwordless OTP identity, invitations, patient↔user link, address, verificationStatus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String?
  emailVerified Boolean            @default(false)
  phone         String?            @unique
  phoneVerified Boolean            @default(false)
  status        String             @default("active")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  identities    UserIdentity[]
  sessions      AuthSession[]
  memberships   Membership[]
  platformRoles UserPlatformRole[]
  practitioners Practitioner[]
  patientLinks  PatientUserLink[]  @relation("PatientUserLinkUser")
  linkedPatients PatientUserLink[] @relation("PatientUserLinkActor")
  invitationsCreated OrganizationInvitation[] @relation("InvitationCreator")
  invitationsRedeemed OrganizationInvitation[] @relation("InvitationRedeemer")
  clinicCodesCreated ClinicCode[] @relation("ClinicCodeCreator")

  @@map("users")
}

model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  issuer    String
  subject   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

model AuthSession {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  subject         String
  issuer          String
  email           String?
  emailVerified   Boolean?
  displayName     String?
  authenticatedAt DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthLoginTransaction {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  nonceHash   String
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("auth_login_transactions")
}

model Organization {
  id            String                         @id @default(cuid())
  name          String
  status        String                         @default("active")
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  branches      Branch[]
  memberships   Membership[]
  patients      Patient[]
  practitioners Practitioner[]
  appointments  Appointment[]
  practitionerAssignments PractitionerBranchAssignment[]
  practitionerSchedules   PractitionerSchedule[]
  practitionerUnavailability PractitionerUnavailability[]
  practitionerHistory     PractitionerHistory[]
  invitations   OrganizationInvitation[]
  clinicCodes   ClinicCode[]
  registrationSessions RegistrationSession[]
  patientUserLinks PatientUserLink[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  appointments   Appointment[]
  practitionerAssignments PractitionerBranchAssignment[]
  practitionerSchedules   PractitionerSchedule[]

  @@index([organizationId])
  @@map("branches")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  branchId       String?
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id            String             @id
  key           String             @unique
  name          String
  scope         String
  createdAt     DateTime           @default(now())
  permissions   RolePermission[]
  memberships   MembershipRole[]
  platformUsers UserPlatformRole[]

  @@map("roles")
}

model Permission {
  id        String           @id
  key       String           @unique
  name      String
  scope     String
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model UserPlatformRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_platform_roles")
}

model SecurityEvent {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  outcome        String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId])
  @@map("security_events")
}

model Patient {
  id             String       @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  dateOfBirth    DateTime     @db.Date
  email                             String?
  phone                             String?
  status                            String    @default("active")
  appointmentNotificationConsent    Boolean   @default(false)
  appointmentNotificationConsentAt  DateTime?
  appointmentNotificationOptOut     Boolean   @default(false)
  appointmentNotificationOptedOutAt DateTime?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
  organization                      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments                      Appointment[]
  userLink                          PatientUserLink?
  addresses                         PatientAddress[]

  @@index([organizationId])
  @@map("patients")
}

model Practitioner {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @unique
  displayName    String?
  status         String       @default("active")
  verificationStatus String   @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  assignments    PractitionerBranchAssignment[]
  schedules      PractitionerSchedule[]
  unavailability PractitionerUnavailability[]
  history        PractitionerHistory[]
  addresses      PractitionerAddress[]

  @@index([organizationId])
  @@index([organizationId, verificationStatus])
  @@map("practitioners")
}

model PractitionerBranchAssignment {
  id             String       @id @default(cuid())
  organizationId String
  practitionerId String
  branchId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, branchId])
  @@index([organizationId])
  @@index([branchId])
  @@map("practitioner_branch_assignments")
}

model PractitionerSchedule {
  id             String       @id @default(cuid())
  organizationId String
  practitionerId String
  branchId       String
  timezone       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  intervals      PractitionerWeeklyInterval[]

  @@unique([practitionerId, branchId])
  @@index([organizationId])
  @@map("practitioner_schedules")
}

model PractitionerWeeklyInterval {
  id             String               @id @default(cuid())
  scheduleId     String
  organizationId String
  practitionerId String
  branchId       String
  weekday        Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime             @default(now())
  schedule       PractitionerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId])
  @@index([practitionerId, branchId, weekday])
  @@map("practitioner_weekly_intervals")
}

model PractitionerUnavailability {
  id             String       @id @default(cuid())
  organizationId String
  practitionerId String
  kind           String
  status         String       @default("active")
  startAtUtc     DateTime     @db.Timestamptz
  endAtUtc       DateTime     @db.Timestamptz
  timezone       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([organizationId, practitionerId, startAtUtc])
  @@map("practitioner_unavailability")
}

model PractitionerHistory {
  id             String       @id @default(cuid())
  organizationId String
  practitionerId String
  eventType      String
  actorUserId    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([practitionerId, createdAt])
  @@index([organizationId])
  @@map("practitioner_history")
}

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  patientId      String
  practitionerId String
  startAtUtc     DateTime     @db.Timestamptz
  endAtUtc       DateTime     @db.Timestamptz
  timezone       String
  status         String       @default("REQUESTED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  history        AppointmentHistory[]
  outbox         NotificationOutbox[]

  @@index([organizationId, startAtUtc])
  @@index([organizationId, status])
  @@index([organizationId, patientId, startAtUtc])
  @@index([organizationId, practitionerId, startAtUtc])
  @@map("appointments")
}

model AppointmentHistory {
  id             String      @id @default(cuid())
  appointmentId  String
  organizationId String
  eventType      String
  fromStatus     String?
  toStatus       String
  actorUserId    String
  createdAt      DateTime    @default(now())
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
  @@index([organizationId])
  @@map("appointment_history")
}

model NotificationOutbox {
  id                String      @id @default(cuid())
  organizationId    String
  appointmentId     String
  eventType         String
  status            String      @default("pending")
  attemptCount      Int         @default(0)
  claimedAt         DateTime?   @db.Timestamptz
  claimedUntil      DateTime?   @db.Timestamptz
  claimedBy         String?
  nextAttemptAt     DateTime    @default(now()) @db.Timestamptz
  processedAt       DateTime?   @db.Timestamptz
  lastErrorCode     String?
  providerMessageId String?
  createdAt         DateTime    @default(now())
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("notification_outbox")
}

// --- C3 passwordless OTP identity & registration (TDA-ADR-004) ---

model Address {
  id         String   @id @default(cuid())
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patients   PatientAddress[]
  practitioners PractitionerAddress[]

  @@map("addresses")
}

model PatientAddress {
  patientId  String
  addressId  String
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  address    Address  @relation(fields: [addressId], references: [id], onDelete: Restrict)

  @@id([patientId, addressId])
  @@index([addressId])
  @@map("patient_addresses")
}

model PractitionerAddress {
  practitionerId String
  addressId      String
  isPrimary      Boolean  @default(true)
  createdAt      DateTime @default(now())
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  address        Address      @relation(fields: [addressId], references: [id], onDelete: Restrict)

  @@id([practitionerId, addressId])
  @@index([addressId])
  @@map("practitioner_addresses")
}

model PatientUserLink {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String   @unique
  userId         String
  linkedAt       DateTime @default(now())
  linkedByUserId String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user           User         @relation("PatientUserLinkUser", fields: [userId], references: [id], onDelete: Restrict)
  linkedBy       User?        @relation("PatientUserLinkActor", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("patient_user_links")
}

model OrganizationInvitation {
  id               String   @id @default(cuid())
  organizationId   String
  purpose          String
  tokenHash        String   @unique
  emailHint        String?
  status           String   @default("PENDING")
  expiresAt        DateTime
  createdByUserId  String
  redeemedAt       DateTime?
  redeemedByUserId String?
  maxUses          Int      @default(1)
  useCount         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User         @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  redeemedBy       User?        @relation("InvitationRedeemer", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  registrationSessions RegistrationSession[]

  @@index([organizationId, purpose, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model ClinicCode {
  id              String   @id @default(cuid())
  organizationId  String
  purpose         String   @default("PATIENT")
  codeHash        String
  label           String?
  status          String   @default("ACTIVE")
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("ClinicCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  registrationSessions RegistrationSession[]

  @@unique([organizationId, codeHash])
  @@index([organizationId, status])
  @@map("clinic_codes")
}

model RegistrationSession {
  id              String   @id @default(cuid())
  purpose         String
  organizationId  String
  invitationId    String?
  clinicCodeId    String?
  status          String   @default("IN_PROGRESS")
  email           String?
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  firstName       String?
  lastName        String?
  displayName     String?
  addressDraft    Json?
  expiresAt       DateTime
  completedUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitation      OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  clinicCode      ClinicCode? @relation(fields: [clinicCodeId], references: [id], onDelete: Restrict)
  otpChallenges   AuthOtpChallenge[]

  @@index([organizationId, status])
  @@index([expiresAt])
  @@index([invitationId])
  @@map("registration_sessions")
}

model AuthOtpChallenge {
  id                     String   @id @default(cuid())
  destinationType        String
  destinationNormalized  String
  purpose                String
  codeSalt               String
  codeHash               String
  registrationSessionId  String?
  organizationId         String?
  invitationId           String?
  userId                 String?
  attempts               Int      @default(0)
  maxAttempts            Int
  expiresAt              DateTime
  consumedAt             DateTime?
  lastSentAt             DateTime
  resendCount            Int      @default(0)
  ipHash                 String?
  createdAt              DateTime @default(now())
  registrationSession    RegistrationSession? @relation(fields: [registrationSessionId], references: [id], onDelete: Restrict)

  @@index([destinationNormalized, purpose, createdAt])
  @@index([expiresAt])
  @@index([registrationSessionId])
  @@index([userId, purpose, createdAt])
  @@map("auth_otp_challenges")
}

model AuthRateLimitBucket {
  id              String   @id @default(cuid())
  bucketKey       String
  windowStartedAt DateTime
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([bucketKey, windowStartedAt])
  @@index([bucketKey])
  @@map("auth_rate_limit_buckets")
}
