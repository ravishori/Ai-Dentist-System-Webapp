// DentalCare AI — Prisma schema
//
// PostgreSQL is the transactional system of record (TDA-IMP-M0-002, TDA-ADR-001).
// Schema evolution is owned by Prisma migrations.
//
// M1: authentication identity-mapping and session persistence.
// M2: organization/tenant, membership, RBAC catalog, security event log.
// M3: organization-scoped patient identity (not clinical records).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String?
  emailVerified Boolean            @default(false)
  status        String             @default("active")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  identities    UserIdentity[]
  sessions      AuthSession[]
  memberships   Membership[]
  platformRoles UserPlatformRole[]

  @@map("users")
}

model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  issuer    String
  subject   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

model AuthSession {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  subject         String
  issuer          String
  email           String?
  emailVerified   Boolean?
  displayName     String?
  authenticatedAt DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthLoginTransaction {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  nonceHash   String
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("auth_login_transactions")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branches    Branch[]
  memberships Membership[]
  patients    Patient[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]

  @@index([organizationId])
  @@map("branches")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  branchId       String?
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id            String             @id
  key           String             @unique
  name          String
  scope         String
  createdAt     DateTime           @default(now())
  permissions   RolePermission[]
  memberships   MembershipRole[]
  platformUsers UserPlatformRole[]

  @@map("roles")
}

model Permission {
  id        String           @id
  key       String           @unique
  name      String
  scope     String
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model UserPlatformRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_platform_roles")
}

model SecurityEvent {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  outcome        String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId])
  @@map("security_events")
}

model Patient {
  id             String       @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  dateOfBirth    DateTime     @db.Date
  email          String?
  phone          String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("patients")
}
