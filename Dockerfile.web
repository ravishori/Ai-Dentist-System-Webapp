# AI Dentist — staging/production-capable web image (apps/web).
# Multi-stage monorepo build. No secrets baked into the image.
# Staging platform proposal: Render (see docs/adr/ADR-IMP-005-staging-hosting-render.md).

FROM node:22-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/application/package.json packages/application/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/test-utils/package.json packages/test-utils/
RUN pnpm install --frozen-lockfile
COPY . .
# Placeholder config only for build-time tooling. Runtime injects real values.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    AUTH_PROVIDER=unset \
    DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dentalcare \
    APP_BASE_URL=http://localhost:3000 \
    NOTIFICATION_PROCESSING_ENABLED=false \
    NOTIFICATION_PROVIDER=unset \
    NOTIFICATION_ALLOW_REAL_DELIVERY=false
RUN pnpm build:packages && pnpm --filter @dentalcare/web build

FROM base AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    AUTH_PROVIDER=unset \
    NOTIFICATION_PROCESSING_ENABLED=false \
    NOTIFICATION_PROVIDER=unset \
    NOTIFICATION_ALLOW_REAL_DELIVERY=false
WORKDIR /app
COPY --from=build /app /app
EXPOSE 3000
USER node
# Render and other hosts inject PORT. Bind all interfaces.
CMD ["sh", "-c", "pnpm --filter @dentalcare/web exec next start --hostname 0.0.0.0 --port ${PORT:-3000}"]
