# DentalCare AI — local/CI environment template
# Placeholders only. Never commit real secrets, passwords, API keys, or production credentials.
# Copy to `.env` for local development: `cp .env.example .env`

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Prisma). Replace USER and PASSWORD locally; do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dentalcare

# Authentication provider is not selected at M0.
# Allowed values until M1 identity ADR: unset
# Do not implement a custom password system in this repository at M0.
AUTH_PROVIDER=unset

# Notification providers are configured in M4. Names only at M0; leave unset locally.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Public web origin (non-secret)
APP_BASE_URL=http://localhost:3000
