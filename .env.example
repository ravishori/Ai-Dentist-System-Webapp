# DentalCare AI — local/CI/staging environment template
# Placeholders only. Never commit real secrets, passwords, API keys, or production credentials.
# Copy to `.env` for local development: `cp .env.example .env`
#
# Classification:
#   BUILD    — may be present as placeholders during image build
#   RUNTIME  — required or optional at process start
#   DISABLED — safe defaults; do not enable without human approval
#   FUTURE   — production/staging Cognito or SMTP when authorized

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Prisma). Replace USER and PASSWORD locally; do not commit real credentials.
# RUNTIME (web + worker). Staging: inject via Render database link — never commit the real URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dentalcare

# Authentication. M1 Cognito OIDC (`managed`) and C3 app OTP (`otp`) share AuthenticationPort + dc_session.
# Local/CI default remains unset so the app starts without Cognito or OTP providers.
# Set AUTH_PROVIDER=managed only with real (non-committed) Cognito values.
# Set AUTH_PROVIDER=otp only with OTP_ISSUER, OTP_PEPPER, AUTH_SESSION_SECRET (never commit real pepper).
# RUNTIME. Staging/production Cognito or OTP provisioning is a separate human step.
AUTH_PROVIDER=unset
# FUTURE / RUNTIME when AUTH_PROVIDER=managed:
# OIDC_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# AUTH_SESSION_SECRET=
# AUTH_SESSION_TTL_SECONDS=28800
# AUTH_CLOCK_SKEW_SECONDS=60
# AUTH_COOKIE_SECURE=false
# FUTURE / RUNTIME when AUTH_PROVIDER=otp (C3):
# OTP_ISSUER=https://auth.example.test/otp
# OTP_PEPPER=
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_RESENDS=5
# OTP_RATE_LIMIT_WINDOW_SECONDS=60
# OTP_RATE_LIMIT_MAX_REQUESTS=5
# OTP_VERIFY_RATE_LIMIT_MAX=10
# INVITATION_TTL_SECONDS=604800
# REGISTRATION_SESSION_TTL_SECONDS=3600
# SMS_PROVIDER=unset
# OTP_ALLOW_FAKE_SMS=false
# Production must not enable fake SMS. Production SMS vendor is selected after C3 abstractions.

# Notification delivery (M5). Defaults fail closed: no worker processing and no real SMTP.
# Automated tests use a fake adapter only. Do not commit real credentials or sender addresses.
# Retry schedule is a domain constant (M5-07), not environment-configurable:
# 5 total attempts; delays after attempts 1–4: 1m, 5m, 30m, 2h; attempt 5 is terminal.
# DISABLED by default for staging Blueprint as well.
NOTIFICATION_PROCESSING_ENABLED=false
NOTIFICATION_PROVIDER=unset
NOTIFICATION_ALLOW_REAL_DELIVERY=false
NOTIFICATION_POLL_INTERVAL_SECONDS=60
# NOTIFICATION_CLAIM_LEASE_SECONDS=120
# FUTURE SMTP (only when human-approved):
# NOTIFICATION_FROM_EMAIL=
# NOTIFICATION_FROM_DOMAIN=
# NOTIFICATION_FROM_NAME=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Public web origin (non-secret). RUNTIME.
# Local: http://localhost:3000
# Staging: set to the Render HTTPS hostname after first deploy (not dental.trinetralab.net yet).
APP_BASE_URL=http://localhost:3000

# Host listen port for containers / PaaS. RUNTIME (web). Render injects PORT automatically.
# PORT=3000
